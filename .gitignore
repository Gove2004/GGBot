# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 虚拟环境
.venv/
venv/

# 密钥与本地配置（含 AppSecret / API Key，切勿提交）
config.json
# 部署模板入库：真正的 config.json 仍被上面忽略
!**/config.example.json

# 日志
*.log
logs/

# 运行时数据（db/ 下的 config.json / ggbot.db 由上面全局模式忽略；
# db/persona_core.md 需入库，不在此忽略）
*.db
*.db-wal
*.db-shm
db/.bot.lock
# 数据库备份（含完整对话数据，仅本地保留，切勿提交）
db/ggbot.db.bak-*

# 富媒体临时落地目录（图片/语音/视频附件）与本地验证脚本
temp/

# Tool 本地素材/用户数据（体积大或含个人音频，仅本地保留；索引与配置结构见 README）
# 表情分类目录既是代码也是素材库：整目录忽略，只放行四个代码文件、索引与配置模板
tool/emoji/**
!tool/emoji/__init__.py
!tool/emoji/emoji.py
!tool/emoji/_emoji_store.py
!tool/emoji/_emoji_match.py
!tool/emoji/index.json
!tool/emoji/config.example.json
tool/media/audio/*.wav
# 元宝搜索的当天用量计数（按次计费，发版会重启进程，计数要留在服务器上；本地运行数据，不进仓库）
tool/web/search_usage.json

# 编辑器
.idea/
.vscode/
# Qoder 生成的仓库知识缓存（repowiki / 知识卡），不是项目内容
.qoder/
