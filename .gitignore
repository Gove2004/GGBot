# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 虚拟环境
.venv/
venv/

# 密钥与本地配置（含 AppSecret / API Key，切勿提交）
config.json
# 部署模板入库：真正的 config.json 仍被上面忽略
!**/config.example.json

# 日志
*.log
logs/

# 运行时数据（db/ 下的 config.json / ggbot.db 由上面全局模式忽略；
# db/persona_core.md 需入库，不在此忽略）
*.db
*.db-wal
*.db-shm
db/.bot.lock
# 数据库备份（含完整对话数据，仅本地保留，切勿提交）
db/ggbot.db.bak-*

# 富媒体临时落地目录（图片/语音/视频附件）与本地验证脚本
temp/

# Tool 本地素材/用户数据（体积大或含个人音频，仅本地保留；索引与配置结构见 README）
tool/chat/emoji/stickers/
tool/chat/emoji/user/
tool/chat/audio/*.wav

# 编辑器
.idea/
.vscode/
